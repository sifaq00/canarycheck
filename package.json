{
  "name": "canarycheck",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:ext": "pnpm --filter @canarycheck/ext dev",
    "dev:web": "pnpm --filter @canarycheck/web dev",
    "build:ext": "pnpm --filter @canarycheck/ext build",
    "build:web": "pnpm --filter @canarycheck/web build",
    "test": "pnpm --filter @canarycheck/core test",
    "typecheck": "pnpm -r exec tsc --noEmit"
  }
}
